<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Authentication infrastructure for .NET command-line applications. Early development; browser/device login and protected persistence are not implemented.</Description>
    <!-- Final author, license, repository and release metadata are set before publication. -->
    <Authors>Bijecta.CliAuth contributors</Authors>
    <PackageTags>cli;oauth;oidc;authentication</PackageTags>
  </PropertyGroup>
  <!-- Native AOT is a supported consumer target. IsAotCompatible is not set here: its analyzers add an
       implicit ILLink package whose version follows the installed SDK patch, which breaks locked restore.
       CI's native-aot job builds every library with -p:IsAotCompatible=true instead (warnings are errors). -->
  <ItemGroup Condition="'$(IsAotCompatible)' != 'true' and '$(IsTrimmable)' != 'true'">
    <AssemblyMetadata Include="IsTrimmable" Value="True" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
