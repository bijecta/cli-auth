<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" PrivateAssets="all" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/Bijecta.CliAuth.Storage.File/Bijecta.CliAuth.Storage.File.csproj" />
    <ProjectReference Include="../Bijecta.CliAuth.LockProcess/Bijecta.CliAuth.LockProcess.csproj" ReferenceOutputAssembly="false"
      OutputItemType="LockProcessAssembly" />
  </ItemGroup>
  <!-- Copy from the helper's resolved output (honours configuration, RID, and output overrides), including subfolders. -->
  <Target Name="CopyLockProcess" AfterTargets="Build">
    <PropertyGroup>
      <LockProcessOutputDirectory>@(LockProcessAssembly->'%(RootDir)%(Directory)')</LockProcessOutputDirectory>
    </PropertyGroup>
    <Error Condition="'$(LockProcessOutputDirectory)' == ''" Text="The lock helper output could not be resolved." />
    <ItemGroup>
      <LockProcessFiles Include="$(LockProcessOutputDirectory)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(LockProcessFiles)" DestinationFiles="@(LockProcessFiles->'$(OutDir)LockProcess/%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
